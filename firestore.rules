rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{id} {
      // Qualquer pessoa pode ler e criar mensagens válidas; ninguém edita nem apaga.
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['room','nickname','text','isAI','createdAt'])
        && request.resource.data.room in ['ansiedade','tristeza','motivacao']
        && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 30
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
